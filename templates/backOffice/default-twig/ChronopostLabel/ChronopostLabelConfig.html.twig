<form action="{{ path('chronopost.label.config.save') }}" method="post">
    <input type="hidden" name="{{ form.vars.full_name }}[success_url]" value="{{ path('admin.module.configure', {module_code: 'ChronopostLabel'}) }}">
    {% do form.success_url.setRendered %}
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">{{ 'Chronopost informations'|trans({}, 'chronopostlabel.bo.default') }}</h5>
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-save"></i> {{ 'Save'|trans }}
                    </button>
                </div>
                <div class="card-body">
                    {{ form_errors(form) }}
                    {{ form_row(form.chronopost_label_code) }}
                    {{ form_row(form.chronopost_label_password) }}
                    {{ form_row(form.chronopost_label_label_dir) }}
                    {{ form_row(form.chronopost_label_label_type) }}
                    {{ form_row(form.chronopost_label_send_as_customer_status) }}
                    {{ form_row(form.chronopost_label_change_order_status) }}
                    {{ form_row(form.chronopost_label_expiration_date) }}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">{{ 'Shipper informations'|trans({}, 'chronopostlabel.bo.default') }}</h5>
                </div>
                <div class="card-body">
                    {{ form_row(form.chronopost_label_shipper_name1) }}
                    {{ form_row(form.chronopost_label_shipper_name2) }}
                    {{ form_row(form.chronopost_label_shipper_address1) }}
                    {{ form_row(form.chronopost_label_shipper_address2) }}
                    {{ form_row(form.chronopost_label_shipper_country) }}
                    {{ form_row(form.chronopost_label_shipper_city) }}
                    {{ form_row(form.chronopost_label_shipper_zipcode) }}
                    {{ form_row(form.chronopost_label_shipper_civ) }}
                    {{ form_row(form.chronopost_label_shipper_contact_name) }}
                    {{ form_row(form.chronopost_label_shipper_phone) }}
                    {{ form_row(form.chronopost_label_shipper_mobile_phone) }}
                    {{ form_row(form.chronopost_label_shipper_mail) }}
                </div>
            </div>
        </div>
    </div>
    {{ form_rest(form) }}
</form>
