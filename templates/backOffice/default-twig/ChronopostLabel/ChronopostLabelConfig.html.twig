<form action="{{ path('chronopost.label.config.save') }}" method="post">
    <input type="hidden" name="{{ form.vars.full_name }}[success_url]" value="{{ path('admin.module.configure', {module_code: 'ChronopostLabel'}) }}">
    {% do form.success_url.setRendered %}
    <div class="d-flex justify-content-end mb-3">
        <button type="submit" class="btn btn-success btn-sm">
            <i class="bi bi-save"></i> {{ 'Save'|trans }}
        </button>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">{{ 'Chronopost informations'|trans({}, 'chronopostlabel.bo.default') }}</h5>
                </div>
                <div class="card-body">
                    {{ form_errors(form) }}
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_code) }}
                        {{ form_widget(form.chronopost_label_code, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_code) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_password) }}
                        {{ form_widget(form.chronopost_label_password, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_password) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_label_dir) }}
                        {{ form_widget(form.chronopost_label_label_dir, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_label_dir) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_label_type) }}
                        {{ form_widget(form.chronopost_label_label_type, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.chronopost_label_label_type) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_send_as_customer_status) }}
                        {{ form_widget(form.chronopost_label_send_as_customer_status, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.chronopost_label_send_as_customer_status) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_change_order_status) }}
                        {{ form_widget(form.chronopost_label_change_order_status, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.chronopost_label_change_order_status) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_expiration_date) }}
                        {{ form_widget(form.chronopost_label_expiration_date, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_expiration_date) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">{{ 'Shipper informations'|trans({}, 'chronopostlabel.bo.default') }}</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_name1) }}
                        {{ form_widget(form.chronopost_label_shipper_name1, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_name1) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_name2) }}
                        {{ form_widget(form.chronopost_label_shipper_name2, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_name2) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_address1) }}
                        {{ form_widget(form.chronopost_label_shipper_address1, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_address1) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_address2) }}
                        {{ form_widget(form.chronopost_label_shipper_address2, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_address2) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_country) }}
                        {{ form_widget(form.chronopost_label_shipper_country, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_country) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_city) }}
                        {{ form_widget(form.chronopost_label_shipper_city, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_city) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_zipcode) }}
                        {{ form_widget(form.chronopost_label_shipper_zipcode, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_zipcode) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_civ) }}
                        {{ form_widget(form.chronopost_label_shipper_civ, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_civ) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_contact_name) }}
                        {{ form_widget(form.chronopost_label_shipper_contact_name, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_contact_name) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_phone) }}
                        {{ form_widget(form.chronopost_label_shipper_phone, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_phone) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_mobile_phone) }}
                        {{ form_widget(form.chronopost_label_shipper_mobile_phone, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_mobile_phone) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.chronopost_label_shipper_mail) }}
                        {{ form_widget(form.chronopost_label_shipper_mail, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.chronopost_label_shipper_mail) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{ form_rest(form) }}
</form>
